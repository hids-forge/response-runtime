# Optional local build configuration for response-runtime.
# Copy to .env and edit if you want persistent local build defaults.

# Build the emergency-response MQTT control-plane binary in addition to active-response.
BUILD_EMERGENCY_RESPONSE=0

# Enable emergency-response RPC such as openShell and endpoint file extraction.
ENABLE_DANGER_EMERGENCIES=0

# Enable non-JS unsafe local control or destructive behaviors.
# This includes features such as run-command and gated file deletion paths.
ENABLE_UNSAFE_FEATURES=0

# Enable HTTP self-update and related remote update commands.
ENABLE_REMOTE_UPDATES=0

# Default signed manifest URL for updater-enabled builds.
# Keep this as a neutral sample unless you operate your own update service.
# You can also override it per build: make build ENABLE_REMOTE_UPDATES=1 UPDATE_MANIFEST_URL=...
UPDATE_MANIFEST_URL=https://updates.example.invalid/response-runtime/manifest.json

# Enable JS file-content reads such as readFile and readTextFile.
ENABLE_JS_FILE_READS=0

# Enable JS sensitive local reads such as hosts file entries, auth failure logs,
# and Windows registry readers.
ENABLE_JS_SENSITIVE_READS=0

# Enable JS local-control and local code-loading helpers such as:
# - exec
# - writeFile / writeTextFile
# - importModule from local files
ENABLE_JS_UNSAFE_FEATURES=0

# Enable importModule over HTTP(S).
ENABLE_JS_HTTP_IMPORT=0

# Enable JS HTTP helpers such as httpGet and httpPost.
ENABLE_HTTP_CLIENT=0

# Enable JS active network probes such as ping, traceroute, DNS lookups,
# TCP/UDP reachability checks, banners, and fingerprinting.
ENABLE_JS_NETWORK_PROBES=0

# Enable JS recursive directory walking.
ENABLE_JS_WALK_DIR=0

# Enable authenticated JS helpers such as sshExec.
ENABLE_JS_UNSAFE_WITH_AUTH=0

# Optional output binary names.
ACTIVE_RESPONSE_BIN=active-response
EMERGENCY_RESPONSE_BIN=emergency-response

# Optional per-OS output filename overrides.
ACTIVE_RESPONSE_NAME_LINUX=active-response-linux
ACTIVE_RESPONSE_NAME_DARWIN=active-response-macos
ACTIVE_RESPONSE_NAME_WINDOWS=active-response.exe

EMERGENCY_RESPONSE_NAME_LINUX=emergency-response-linux
EMERGENCY_RESPONSE_NAME_DARWIN=emergency-response-macos
EMERGENCY_RESPONSE_NAME_WINDOWS=emergency-response.exe

# Optional runtime override for emergency-response when locating its companion
# active-response binary for runJS.
# RESPONSE_RUNTIME_ACTIVE_RESPONSE_BIN=/opt/response-runtime/active-response
